{
  "name": "react-templates",
  "version": "0.1.0",
  "description": "Two interactive landing-page sections for React: an availability picker and a quarterly roadmap timeline with a detail modal.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/ui-sections.cjs",
  "module": "./dist/ui-sections.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui-sections.js",
      "require": "./dist/ui-sections.cjs"
    },
    "./style.css": "./dist/style.css"
  }
}
